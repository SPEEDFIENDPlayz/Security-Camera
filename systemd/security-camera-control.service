[Unit]
Description=Security camera configuration control worker
After=security-camera-recorder.service

[Service]
Type=simple
User=root
Group=securitycam
Environment=SECURITY_CAMERA_CONFIG=/etc/security-camera/config.toml
WorkingDirectory=/opt/security-camera
ExecStart=/opt/security-camera/.venv/bin/security-camera control
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/security-camera /var/lib/security-camera

[Install]
WantedBy=multi-user.target
